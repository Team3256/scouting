{
  "name": "create-t3-turbo",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@8.11.0",
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "postinstall": "pnpm lint:ws",
    "db:push": "pnpm -F db push",
    "db:studio": "pnpm -F db studio",
    "dev": "turbo dev --parallel",
    "dev:expo:go": "pnpm -F expo dev:go",
    "build:ios": "pnpm -F expo build:ios",
    "build:ios:local": "pnpm -F expo build:ios:local",
    "build:ios:local:non-interactive": "pnpm -F expo build:ios:local:non-interactive",
    "format": "turbo format --continue -- --cache --cache-location node_modules/.cache/.prettiercache",
    "format:fix": "turbo format --continue -- --write --cache --cache-location node_modules/.cache/.prettiercache",
    "lint": "turbo lint --continue -- --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "turbo lint --continue -- --fix --cache-location node_modules/.cache/.eslintcache",
    "lint:ws": "sherif",
    "typecheck": "turbo typecheck",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "preinstall": "node scripts/check-node.mjs",
    "test:security": "node scripts/test-http-security.mjs",
    "verify:tls": "node scripts/test-http-security.mjs --network"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:^0.1.0",
    "@turbo/gen": "^1.11.3",
    "prettier": "^3.2.5",
    "sherif": "1.13.0",
    "turbo": "^1.11.3",
    "typescript": "^5.3.3"
  },
  "prettier": "@acme/prettier-config",
  "version": "1.0.0",
  "pnpm": {
    "overrides": {
      "axios@1": "1.20.0",
      "express@4": "4.22.3",
      "follow-redirects": "1.16.1",
      "proxy-addr": "2.0.8",
      "ws@8": "8.21.0",
      "ws@7": "7.5.11",
      "ws@6": "6.2.4",
      "form-data@3": "3.0.5",
      "form-data@4": "4.0.6",
      "@opentelemetry/api": "1.9.0",
      "basic-ftp@5": "5.3.1",
      "fast-xml-parser@4": "4.5.7",
      "handlebars@4": "4.7.10",
      "shell-quote@1": "1.12.0"
    }
  }
}
